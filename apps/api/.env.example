JWT_PUBLIC_KEY_B64=
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:8081", "exp://localhost:8081"]
APP_ENV=development
